{
  "id": "bpReplyGuard001",
  "name": "Blueprint - Hold queued actions on reply",
  "description": "Runs a bounded read-only reply scan and routes any detected reply or scan failure to a queue hold. The example command is a placeholder and no outbound action is present.",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [160, 220]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 3
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 3 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [160, 380]
    },
    {
      "parameters": {
        "command": "python3 /opt/agentic-gtm/check_replies.py --read-only --json"
      },
      "id": "scan-replies",
      "name": "Scan replies read-only",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [460, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "reply-found",
              "leftValue": "={{ $('Scan replies read-only').item.json.stdout }}",
              "rightValue": "\"reply_detected\": true",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "reply-detected",
      "name": "Reply detected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, 220]
    },
    {
      "parameters": {},
      "id": "hold-reply",
      "name": "Hold queue - reply detected",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [980, 140]
    },
    {
      "parameters": {},
      "id": "leave-unchanged",
      "name": "No reply - leave queue unchanged",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [980, 300]
    },
    {
      "parameters": {},
      "id": "hold-failure",
      "name": "Hold queue - scan failed",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [720, 460]
    }
  ],
  "connections": {
    "Run manually": {
      "main": [[{"node": "Scan replies read-only", "type": "main", "index": 0}]]
    },
    "Every 3 hours": {
      "main": [[{"node": "Scan replies read-only", "type": "main", "index": 0}]]
    },
    "Scan replies read-only": {
      "main": [
        [{"node": "Reply detected?", "type": "main", "index": 0}],
        [{"node": "Hold queue - scan failed", "type": "main", "index": 0}]
      ]
    },
    "Reply detected?": {
      "main": [
        [{"node": "Hold queue - reply detected", "type": "main", "index": 0}],
        [{"node": "No reply - leave queue unchanged", "type": "main", "index": 0}]
      ]
    }
  },
  "settings": {}
}
